{
  "name": "farmcommerce-api",
  "version": "0.1.6",
  "private": true,
  "scripts": {
    "test": "yarn test:functional",
    "test:functional": "node --inspect=5858 ./node_modules/.bin/cucumber-js -c src/tests/functional/cucumber.js",
    "test:performance": "node --inspect=5859 ./node_modules/.bin/cucumber-js -c src/tests/performance/cucumber.js",
    "start": "node build/api/setup/server/index.js",
    "start:tasks": "node build/api/src/tasks/index.js",
    "prebuild": "rm -rf build/api/",
    "build": "tsc && tsc-alias",
    "postbuild": "copyfiles src/**/*.xlsx build/api/",
    "watch:dev": "OTEL_ENABLED=true tsc-watch --project . --onSuccess 'node --inspect=0.0.0.0:8226 -r ts-node/register -r tsconfig-paths/register setup/server/index.ts'",
    "db:init": "node build/api/setup/db/init.js",
    "dev": "yarn watch:dev",
    "publish:lib": "yarn build && cd build/api/lib && yarn publish",
    "migrate:make": "npx ts-node setup/db/make.ts",
    "migrate:latest": "node build/api/setup/db/migrate.js latest",
    "migrate:up": "node build/api/setup/db/migrate.js up",
    "migrate:down": "node build/api/setup/db/migrate.js down",
    "seed:make": "knex seed:make --cwd setup/db",
    "seed:run": "npx ts-node setup/db/seed.ts"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^8.9.0",
    "@cucumber/pretty-formatter": "^1.0.0",
    "@types/archiver": "^5.3.1",
    "@types/bcrypt": "^5.0.0",
    "@types/bluebird": "^3.5.38",
    "@types/chai": "^4.3.4",
    "@types/formidable": "^2.0.5",
    "@types/koa-bodyparser": "^4.3.8",
    "@types/koa-router": "^7.4.4",
    "@types/koa__cors": "^3.3.0",
    "@types/lodash": "^4.14.186",
    "@types/node-cron": "^3.0.11",
    "@types/sqlstring": "^2.3.0",
    "@types/traverse": "^0.6.32",
    "@types/yargs": "^17.0.17",
    "chai": "^4.3.7",
    "prettier": "^2.5.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.7.0",
    "tsc-watch": "^5.0.3",
    "tsconfig-paths": "^4.1.0",
    "typescript": "^4.8.4"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.282.0",
    "@koa/router": "^12.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/instrumentation-pg": "^0.66.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "archiver": "^5.3.1",
    "axios": "^1.2.1",
    "bcrypt": "^5.1.0",
    "bluebird": "^3.7.2",
    "copyfiles": "^2.4.1",
    "exceljs": "^4.4.0",
    "formidable": "^2.0.1",
    "ioredis": "^5.2.3",
    "knex": "^2.3.0",
    "koa": "^2.13.4",
    "koa-bodyparser": "^4.3.0",
    "koa-cors": "^0.0.16",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "node-cron": "^3.0.3",
    "node-xlsx": "^0.21.0",
    "pg": "^8.8.0",
    "pino": "^10.3.1",
    "traverse": "^0.6.7",
    "winston": "^3.8.2",
    "yargs": "^17.6.2"
  }
}
